<IfModule mod_security.c>
    SecRuleRemoveById 400011
    SecRuleRemoveById 400012
</IfModule>

<IfModule mod_rewrite.c>
    RewriteEngine On
    Options -MultiViews

    # 1. Catch all /iclock/*.aspx and /iclock/* FIRST before any Apache handler
    RewriteRule ^iclock/.*\.aspx$ public/index.php [L,QSA,NC]
    RewriteRule ^iclock/.*$ public/index.php [L,QSA,NC]

    # 2. Force HTTPS for non-biometric traffic
    RewriteCond %{HTTPS} off
    RewriteCond %{REQUEST_URI} !^/iclock [NC]
    RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

    # 3. Route all other traffic through Laravel
    RewriteCond %{REQUEST_URI} !^/public/
    RewriteRule ^(.*)$ public/index.php [L,QSA]
</IfModule>
