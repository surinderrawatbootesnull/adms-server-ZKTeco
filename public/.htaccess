<IfModule mod_rewrite.c>
    <IfModule mod_negotiation.c>
        Options -MultiViews -Indexes
    </IfModule>

    RewriteEngine On

    # 1. THE FIREWALL BYPASS: If the machine hits /iclock, handle it immediately as plain HTTP
    # This stops Hostinger from sending a 301/302 redirect back to the machine
    RewriteCond %{REQUEST_URI} ^/iclock [NC]
    RewriteRule ^ index.php [L]

    # 2. STANDARD WEB HTTPS ENFORCEMENT
    # Force HTTPS ONLY for actual web browsers accessing dashboards or pages
    RewriteCond %{HTTPS} off
    RewriteCond %{REQUEST_URI} !^/iclock [NC]
    RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

    # 3. STANDARD LARAVEL ROUTING ENGINE
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteRule ^ index.php [L]
</IfModule>
